# 複製成 .env 後再依本機環境調整：cp .env.example .env
# 所有變數會在啟動時由 src/config/env.ts 驗證，缺漏或格式錯誤會直接中止程式

# development | test | production
NODE_ENV=development
PORT=3000

# 前端網址，用於 CORS 白名單。必填，且需為合法 URL
CORS_ORIGIN=http://localhost:5173

DB_HOST=localhost
# PostgreSQL 預設 5432；若本機已有其他實例佔用，改成閒置 port（例如 5433）
DB_PORT=5432
DB_USERNAME=postgres
# 可留空，供本機免密碼的 PostgreSQL 使用
DB_PASSWORD=postgres
DB_NAME=my_project

# 至少 32 字元，兩組請用不同的值
# 產生方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-string
# 時間格式同 jsonwebtoken：15m / 2h / 7d
JWT_ACCESS_EXPIRES_IN=15m

JWT_REFRESH_SECRET=replace-with-another-long-random-string
JWT_REFRESH_EXPIRES_IN=7d

# 允許 10~15，每 +1 雜湊耗時翻倍
BCRYPT_SALT_ROUNDS=10
