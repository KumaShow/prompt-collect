# Automatically install peerDependencies when possible.
# This reduces missing peer dependency warnings during install.
auto-install-peers=true

# Do not save exact versions on install.
# Example: saves ^1.2.3 instead of 1.2.3.
save-exact=false

# If you want to strictly enforce package.json engines (e.g. Node 24.x),
# uncomment the line below.
# engine-strict=true